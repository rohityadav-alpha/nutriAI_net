@model ProfileViewModel
@{ ViewData["Title"] = "Profile & Settings"; }

<div class="page-content">
    <div class="page-header animate-in">
        <h1><i data-lucide="user"></i> Profile & Settings</h1>
        <p>Manage your account and preferences</p>
    </div>

    <!-- User Info Banner -->
    <div class="card card-no-hover mb-6 animate-in animate-delay-1" style="border-left:3px solid #10b981;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
            <div style="display:flex;align-items:center;gap:16px;">
                <div style="width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(16,185,129,0.15);border:2px solid rgba(16,185,129,0.4);">
                    <i data-lucide="user" style="width:32px;height:32px;color:#10b981;"></i>
                </div>
                <div>
                    <h2 style="font-size:20px;font-weight:700;color:white;" id="displayName">@(Model.Name ?? "User")</h2>
                    <p style="color:#94a3b8;font-size:14px;">@Model.Email</p>
                    @if (!string.IsNullOrEmpty(Model.Goal))
                    {
                        <span class="tag" style="margin-top:8px;">Goal: @Model.Goal</span>
                    }
                </div>
            </div>
            <form method="post" asp-action="Logout" asp-controller="Profile">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i data-lucide="log-out" style="width:16px;height:16px;"></i> Sign Out
                </button>
            </form>
        </div>
    </div>

    <div class="grid grid-2">
        <!-- Personal Info -->
        <div class="card card-no-hover animate-in animate-delay-2">
            <h2 style="font-size:16px;font-weight:700;color:white;margin-bottom:20px;display:flex;align-items:center;gap:8px;">
                <i data-lucide="user" style="width:18px;height:18px;color:#10b981;"></i> Personal Information
            </h2>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" class="form-input" value="@Model.Email" disabled />
            </div>
            <div class="form-group">
                <label class="form-label">Name</label>
                <input type="text" id="name" class="form-input" value="@Model.Name" placeholder="Your name" />
            </div>
            <div class="grid grid-2" style="gap:12px;">
                <div class="form-group">
                    <label class="form-label">Weight (kg)</label>
                    <input type="number" id="weight" class="form-input" value="@Model.Weight" placeholder="e.g., 70" />
                </div>
                <div class="form-group">
                    <label class="form-label">Height (cm)</label>
                    <input type="number" id="height" class="form-input" value="@Model.Height" placeholder="e.g., 175" />
                </div>
            </div>
            <div class="grid grid-2" style="gap:12px;">
                <div class="form-group">
                    <label class="form-label">Age</label>
                    <input type="number" id="age" class="form-input" value="@Model.Age" placeholder="e.g., 25" />
                </div>
                <div class="form-group">
                    <label class="form-label">Gender</label>
                    <select id="gender" class="form-select">
                        <option value="">Select</option>
                        <option value="male" selected="@(Model.Gender == "male")">Male</option>
                        <option value="female" selected="@(Model.Gender == "female")">Female</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Goals -->
        <div class="card card-no-hover animate-in animate-delay-3">
            <h2 style="font-size:16px;font-weight:700;color:white;margin-bottom:20px;display:flex;align-items:center;gap:8px;">
                <i data-lucide="target" style="width:18px;height:18px;color:#06b6d4;"></i> Goals & Activity
            </h2>
            <div class="form-group">
                <label class="form-label">Your Goal</label>
                <select id="goal" class="form-select">
                    <option value="">Select your goal</option>
                    <option value="lose" selected="@(Model.Goal == "lose")">Lose Weight</option>
                    <option value="maintain" selected="@(Model.Goal == "maintain")">Maintain Weight</option>
                    <option value="gain" selected="@(Model.Goal == "gain")">Gain Muscle</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Activity Level</label>
                <select id="activityLevel" class="form-select">
                    <option value="">Select activity level</option>
                    <option value="sedentary" selected="@(Model.ActivityLevel == "sedentary")">Sedentary (little or no exercise)</option>
                    <option value="light" selected="@(Model.ActivityLevel == "light")">Light (exercise 1-3 days/week)</option>
                    <option value="moderate" selected="@(Model.ActivityLevel == "moderate")">Moderate (exercise 3-5 days/week)</option>
                    <option value="active" selected="@(Model.ActivityLevel == "active")">Active (hard exercise 6-7 days/week)</option>
                    <option value="veryActive" selected="@(Model.ActivityLevel == "veryActive")">Very Active (intense daily exercise)</option>
                </select>
            </div>
            <button class="btn btn-primary btn-block" style="padding:14px;margin-top:16px;" onclick="saveProfile()" id="saveBtn">
                <i data-lucide="save" style="width:18px;height:18px;"></i> <span id="saveBtnText">Save Profile</span>
            </button>
        </div>
    </div>

    <!-- Daily Targets -->
    <div class="hidden mt-6" id="targetsSection">
        <div class="card card-no-hover animate-in">
            <h2 style="font-size:16px;font-weight:700;color:white;margin-bottom:20px;display:flex;align-items:center;gap:8px;">
                <i data-lucide="settings" style="width:18px;height:18px;color:#10b981;"></i> Your Daily Targets
            </h2>
            <div class="grid grid-4" style="gap:16px;">
                <div style="padding:20px;border-radius:12px;text-align:center;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2);transition:all 0.2s ease;" class="stat-card">
                    <i data-lucide="flame" style="width:32px;height:32px;color:#10b981;margin:0 auto 8px;display:block;"></i>
                    <p style="font-size:24px;font-weight:700;color:#10b981;" id="tCalories">@(Model.TargetCalories ?? 0)</p>
                    <p style="font-size:14px;color:#94a3b8;">Calories</p>
                </div>
                <div style="padding:20px;border-radius:12px;text-align:center;background:rgba(6,182,212,0.08);border:1px solid rgba(6,182,212,0.2);transition:all 0.2s ease;" class="stat-card">
                    <i data-lucide="beef" style="width:32px;height:32px;color:#06b6d4;margin:0 auto 8px;display:block;"></i>
                    <p style="font-size:24px;font-weight:700;color:#06b6d4;" id="tProtein">@(Model.TargetProtein ?? 0)g</p>
                    <p style="font-size:14px;color:#94a3b8;">Protein</p>
                </div>
                <div style="padding:20px;border-radius:12px;text-align:center;background:rgba(20,184,166,0.08);border:1px solid rgba(20,184,166,0.2);transition:all 0.2s ease;" class="stat-card">
                    <i data-lucide="wheat" style="width:32px;height:32px;color:#14b8a6;margin:0 auto 8px;display:block;"></i>
                    <p style="font-size:24px;font-weight:700;color:#14b8a6;" id="tCarbs">@(Model.TargetCarbs ?? 0)g</p>
                    <p style="font-size:14px;color:#94a3b8;">Carbs</p>
                </div>
                <div style="padding:20px;border-radius:12px;text-align:center;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2);transition:all 0.2s ease;" class="stat-card">
                    <i data-lucide="droplet" style="width:32px;height:32px;color:#10b981;margin:0 auto 8px;display:block;"></i>
                    <p style="font-size:24px;font-weight:700;color:#10b981;" id="tFats">@(Model.TargetFats ?? 0)g</p>
                    <p style="font-size:14px;color:#94a3b8;">Fats</p>
                </div>
            </div>
            <p style="font-size:13px;color:#64748b;text-align:center;margin-top:20px;">These targets are calculated based on your profile and goals. Update your profile to recalculate.</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Show targets if they exist
    @if (Model.TargetCalories != null && Model.TargetCalories > 0)
    {
        <text>document.getElementById('targetsSection').classList.remove('hidden');</text>
    }

    async function saveProfile() {
        document.getElementById('saveBtnText').textContent = 'Saving...';
        const body = {
            name: document.getElementById('name').value || null,
            weight: parseFloat(document.getElementById('weight').value) || null,
            height: parseFloat(document.getElementById('height').value) || null,
            age: parseInt(document.getElementById('age').value) || null,
            gender: document.getElementById('gender').value || null,
            goal: document.getElementById('goal').value || null,
            activityLevel: document.getElementById('activityLevel').value || null
        };

        try {
            const res = await fetch('/Profile/Save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const r = await res.json();

            if (r.success) {
                document.getElementById('saveBtnText').textContent = 'Saved!';
                if (body.name) document.getElementById('displayName').textContent = body.name;

                if (r.targetCalories) {
                    document.getElementById('targetsSection').classList.remove('hidden');
                    document.getElementById('tCalories').textContent = r.targetCalories;
                    document.getElementById('tProtein').textContent = r.targetProtein + 'g';
                    document.getElementById('tCarbs').textContent = r.targetCarbs + 'g';
                    document.getElementById('tFats').textContent = r.targetFats + 'g';
                }

                setTimeout(() => {
                    document.getElementById('saveBtnText').textContent = 'Save Profile';
                }, 3000);
            } else {
                alert('Error: ' + (r.error || 'Something went wrong'));
                document.getElementById('saveBtnText').textContent = 'Save Profile';
            }
        } catch {
            alert('Network error');
            document.getElementById('saveBtnText').textContent = 'Save Profile';
        }
    }
</script>
}
