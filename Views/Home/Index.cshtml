@{
    ViewData["Title"] = "AI-Powered Nutrition Tracking";
    ViewData["HideNavbar"] = true;
}

<div class="page-wrapper ambient-bg" style="overflow-x:hidden;">

    <!-- Landing Navbar -->
    <nav class="navbar" style="position:sticky;">
        <div class="navbar-inner">
            <a href="/" class="navbar-logo">
                <div class="navbar-logo-icon">
                    <i data-lucide="leaf"></i>
                </div>
                <div class="navbar-brand">Nutri<span>AI</span></div>
            </a>
            <div style="display:flex;align-items:center;gap:16px;">
                <a href="/Account/Login" style="color:#94a3b8;font-size:14px;font-weight:500;">Sign In</a>
                <a href="/Account/Register" class="btn btn-primary btn-sm" style="padding:8px 20px;">Get Started</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section style="max-width:1280px;margin:0 auto;padding:112px 16px 80px;text-align:center;position:relative;z-index:1;">
        <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:999px;padding:6px 16px;margin-bottom:32px;">
            <i data-lucide="sparkles" style="width:16px;height:16px;color:#10b981;"></i>
            <span style="color:#10b981;font-size:14px;font-weight:500;">Powered by Google Gemini AI</span>
        </div>

        <h1 style="font-size:clamp(36px,7vw,72px);font-weight:800;color:white;margin-bottom:24px;line-height:1.1;">
            Track Your Nutrition<br/>
            <span class="gradient-text">with AI</span>
        </h1>
        <p style="font-size:18px;color:#94a3b8;max-width:600px;margin:0 auto 40px;">
            Simply snap a photo of your meal and let AI instantly analyze calories,
            protein, carbs, and fats. No manual logging required.
        </p>

        <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center;">
            <a href="/Account/Register" class="btn btn-primary btn-lg">
                Start Free <i data-lucide="chevron-right" style="width:20px;height:20px;"></i>
            </a>
            <a href="/Account/Login" class="btn btn-secondary btn-lg">Sign In</a>
        </div>

        <!-- Demo Card -->
        <div style="margin-top:80px;">
            <div class="card card-no-hover" style="max-width:700px;margin:0 auto;">
                <div style="border-radius:12px;padding:40px;text-align:center;background:linear-gradient(135deg,rgba(16,185,129,0.08),rgba(6,182,212,0.08));border:1px solid rgba(16,185,129,0.15);">
                    <div style="width:80px;height:80px;border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);">
                        <i data-lucide="camera" style="width:40px;height:40px;color:#10b981;"></i>
                    </div>
                    <p style="color:#cbd5e1;font-size:18px;">Snap a photo of any meal to get instant nutrition analysis</p>
                    <div style="margin-top:24px;display:flex;justify-content:center;gap:16px;flex-wrap:wrap;">
                        <div style="padding:8px 16px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);text-align:center;">
                            <p style="font-size:18px;font-weight:700;color:#10b981;">650</p>
                            <p style="font-size:12px;color:#94a3b8;">Calories</p>
                        </div>
                        <div style="padding:8px 16px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);text-align:center;">
                            <p style="font-size:18px;font-weight:700;color:#06b6d4;">32g</p>
                            <p style="font-size:12px;color:#94a3b8;">Protein</p>
                        </div>
                        <div style="padding:8px 16px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);text-align:center;">
                            <p style="font-size:18px;font-weight:700;color:#14b8a6;">78g</p>
                            <p style="font-size:12px;color:#94a3b8;">Carbs</p>
                        </div>
                        <div style="padding:8px 16px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);text-align:center;">
                            <p style="font-size:18px;font-weight:700;color:#10b981;">24g</p>
                            <p style="font-size:12px;color:#94a3b8;">Fats</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section style="padding:96px 0;background:linear-gradient(180deg,#0a0a0a,#0f1a14,#0a0a0a);position:relative;z-index:1;">
        <div style="max-width:1280px;margin:0 auto;padding:0 16px;">
            <div style="text-align:center;margin-bottom:64px;">
                <h2 style="font-size:36px;font-weight:700;color:white;margin-bottom:16px;">Everything You Need to Track Nutrition</h2>
                <p style="color:#94a3b8;font-size:18px;max-width:560px;margin:0 auto;">Powerful features to help you understand and improve your eating habits</p>
            </div>
            <div class="grid grid-4" style="gap:24px;">
                <div class="card animate-in"><div class="icon-badge mb-4"><i data-lucide="camera" style="color:#10b981;"></i></div><h3 style="font-size:18px;font-weight:700;color:white;margin-bottom:8px;">AI Food Scanner</h3><p style="color:#94a3b8;font-size:14px;">Take a photo and get instant nutrition breakdown powered by Google Gemini AI</p></div>
                <div class="card animate-in animate-delay-1"><div class="icon-badge cyan mb-4"><i data-lucide="history" style="color:#06b6d4;"></i></div><h3 style="font-size:18px;font-weight:700;color:white;margin-bottom:8px;">Meal History</h3><p style="color:#94a3b8;font-size:14px;">Track all your meals with detailed nutrition logs and weekly summaries</p></div>
                <div class="card animate-in animate-delay-2"><div class="icon-badge mb-4"><i data-lucide="trending-up" style="color:#14b8a6;"></i></div><h3 style="font-size:18px;font-weight:700;color:white;margin-bottom:8px;">Analytics</h3><p style="color:#94a3b8;font-size:14px;">Visualize your nutrition trends with beautiful charts and insights</p></div>
                <div class="card animate-in animate-delay-3"><div class="icon-badge cyan mb-4"><i data-lucide="calculator" style="color:#10b981;"></i></div><h3 style="font-size:18px;font-weight:700;color:white;margin-bottom:8px;">Calorie Calculator</h3><p style="color:#94a3b8;font-size:14px;">Calculate your daily calorie and macro needs based on your goals</p></div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section style="padding:80px 0;background:linear-gradient(135deg,rgba(16,185,129,0.12),rgba(6,182,212,0.08));border-top:1px solid rgba(16,185,129,0.15);border-bottom:1px solid rgba(16,185,129,0.15);position:relative;z-index:1;">
        <div style="max-width:800px;margin:0 auto;padding:0 16px;text-align:center;">
            <h2 style="font-size:36px;font-weight:700;color:white;margin-bottom:16px;">Ready to Transform Your Nutrition?</h2>
            <p style="color:#94a3b8;font-size:18px;margin-bottom:40px;">Join thousands of users tracking their meals with AI</p>
            <a href="/Account/Register" class="btn btn-primary btn-lg">
                Get Started Free <i data-lucide="chevron-right" style="width:20px;height:20px;"></i>
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer style="background:#080808;border-top:1px solid rgba(255,255,255,0.05);position:relative;z-index:1;">
        <div style="max-width:1280px;margin:0 auto;padding:40px 16px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
            <div style="display:flex;align-items:center;gap:8px;">
                <div style="background:rgba(16,185,129,0.2);border:1px solid rgba(16,185,129,0.4);padding:6px;border-radius:8px;">
                    <i data-lucide="leaf" style="width:16px;height:16px;color:#10b981;"></i>
                </div>
                <span style="color:white;font-weight:700;">NutriAI</span>
            </div>
            <p style="color:#64748b;font-size:14px;">© 2025 NutriAI. All rights reserved.</p>
        </div>
    </footer>
</div>
