@model RegisterViewModel
@{ ViewData["Title"] = "Create Account"; ViewData["HideNavbar"] = true; }

<div class="auth-page ambient-bg">
    <div class="auth-card animate-in">
        <div style="text-align:center;margin-bottom:32px;">
            <a href="/" style="display:inline-flex;align-items:center;gap:8px;margin-bottom:24px;">
                <div class="navbar-logo-icon"><i data-lucide="leaf"></i></div>
                <span class="navbar-brand">Nutri<span>AI</span></span>
            </a>
            <h1 style="font-size:24px;font-weight:700;color:white;margin-bottom:4px;">Create Account</h1>
            <p style="color:#94a3b8;font-size:14px;">Start tracking your nutrition with AI</p>
        </div>

        <form method="post" asp-action="Register" asp-controller="Account">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error mb-4">
                    <i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;margin-top:2px;"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="form-label">Full Name</label>
                <input type="text" asp-for="FullName" class="form-input" placeholder="Your name" required />
            </div>

            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" asp-for="Email" class="form-input" placeholder="your@email.com" required />
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <input type="password" asp-for="Password" class="form-input" placeholder="Min 6 characters" required />
            </div>

            <div class="form-group">
                <label class="form-label">Confirm Password</label>
                <input type="password" asp-for="ConfirmPassword" class="form-input" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="padding:14px;font-size:15px;margin-top:8px;">
                <i data-lucide="user-plus" style="width:18px;height:18px;"></i> Create Account
            </button>
        </form>

        <p class="auth-divider">Already have an account?</p>
        <a href="/Account/Login" class="btn btn-secondary btn-block" style="padding:12px;">Sign In</a>
    </div>
</div>
